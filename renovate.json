{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>km-tr/renovate-config"],
  "minimumReleaseAge": "3 days",
  "ignorePaths": [".github/workflows/release.yml"],
  "packageRules": [
    {
      "description": "release.yml is generated by dist, so cargo-dist moves by hand with `dist init` (mise.toml and dist-workspace.toml together)",
      "matchPackageNames": ["cargo:cargo-dist"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["patch", "minor", "digest", "lockFileMaintenance"],
      "automerge": true
    }
  ]
}
